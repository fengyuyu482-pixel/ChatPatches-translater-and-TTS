{
  "version": 2,
  "note": "MC locale 与 franc 的交集，按使用人口三级分层",
  "tiers": {
    "T1": {
      "label": "常用",
      "minPopulationM": 44,
      "defaultEnabled": true
    },
    "T2": {
      "label": "次常用",
      "minPopulationM": 8,
      "defaultEnabled": false
    },
    "T3": {
      "label": "其他",
      "minPopulationM": 0,
      "defaultEnabled": false
    }
  },
  "providers": {
    "deepseek": {
      "type": "openai",
      "langField": "promptName",
      "note": "用英文语言名，实测中文名会被当\"翻成中文\""
    },
    "hunyuan_local": {
      "type": "openai",
      "langField": "promptName",
      "note": "同上；本地模型对英文名同样更稳"
    },
    "bilibili": {
      "type": "openai",
      "langField": "promptName",
      "note": "Index-Translate，OpenAI 兼容"
    },
    "mymemory": {
      "type": "get",
      "langField": "providers.mymemory",
      "note": "langpair=源|目标，需 ISO 639-1 带地区"
    }
  },
