                        .option(bool("空搜索显示全部", "关键字为空时显示全部消息", c.searchEmptyShowsFullChat,
                                () -> c.searchEmptyShowsFullChat, v -> c.searchEmptyShowsFullChat = v))
                        .collapsed(true)
                        .build())
