    /** 已知语言名（中/英/日/韩/俄/西/法/越 + 自动检测）。 */
    private static final List<String> KNOWN_LANGS = List.of(
            "自动检测", "中文", "简体中文", "英语", "English", "日语", "日本語",
            "韩语", "한국어", "俄语", "Русский", "西班牙语", "Español", "法语", "Français",
            "越南语", "Tiếng Việt");

    /** 轻校验：返回不合法的项描述（空 = 全部合法）。不阻止保存。 */
    /** 保存后反馈语言识别结果：成功说映射，失败说支持范围。 */
    private static void reportLanguages(TranslateConfig t) {
        java.util.List<String> ok = new java.util.ArrayList<>();
        java.util.List<String> bad = new java.util.ArrayList<>();

        collectLang(ok, bad, "入站源", t.sourceLanguage, true);
        collectLang(ok, bad, "入站目标", t.targetLanguage, false);
        collectLang(ok, bad, "出站源", t.outgoingSourceLanguage, false);
        collectLang(ok, bad, "出站目标", t.outgoingTargetLanguage, true);

        StringBuilder sb = new StringBuilder("");
        if (bad.isEmpty()) {
            sb.append(obro1961.chatpatches.util.I18n.tr("chatstudy.notice.langOk") + " ");
            sb.append(String.join("，", ok));
        } else {
            sb.append(obro1961.chatpatches.util.I18n.tr("chatstudy.notice.langBad") + " ");
            sb.append(String.join("，", bad));
            sb.append(" " + obro1961.chatpatches.util.I18n.tr("chatstudy.notice.supported") + " ");
            sb.append(String.join("、", obro1961.chatpatches.translate.DialogLanguages.supportedNames()));
        }
        String text = sb.toString();

        net.minecraft.client.Minecraft mc = net.minecraft.client.Minecraft.getInstance();
        if (mc.player != null) {
            mc.player.displayClientMessage(Component.literal(text), false);
        }
        obro1961.chatpatches.ChatPatches.LOGGER.info(text);
    }

    private static void collectLang(java.util.List<String> ok, java.util.List<String> bad,
                                    String label, String value, boolean allowAuto) {
        if (value == null || value.isBlank()) {
            bad.add(label + "（空）");
            return;
        }
        if ("自动检测".equals(value.trim())) {
            if (allowAuto) {
                ok.add(label + "=自动");
            } else {
                bad.add(label + "（不能为自动检测）");
            }
            return;
        }
        String code = obro1961.chatpatches.translate.DialogLanguages.codeOf(value);
        if (code == null) {
            bad.add(label + "「" + value + "」");
        } else {
            ok.add(label + " " + value + "→" + code);
        }
    }

    private static List<String> invalidLanguages(TranslateConfig t) {
        List<String> bad = new ArrayList<>();
        checkLang(bad, "入站源语言", t.sourceLanguage, true);
        checkLang(bad, "入站目标语言", t.targetLanguage, false);
        checkLang(bad, "出站源语言", t.outgoingSourceLanguage, false);
        checkLang(bad, "出站目标语言", t.outgoingTargetLanguage, true);
        return bad;
    }

    private static void checkLang(List<String> bad, String label, String value, boolean allowAuto) {
        if (value == null || value.isBlank()) {
            bad.add(label + "（空）");
            return;
        }
        if (!allowAuto && "自动检测".equals(value)) {
            bad.add(label + "（不能为自动检测）");
            return;
        }
        if (!KNOWN_LANGS.contains(value)) {
            bad.add(label + "：" + value);
        }
    }
