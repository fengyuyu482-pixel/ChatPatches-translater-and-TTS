package obro1961.chatpatches.translate;

import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;

/**
 * <b>语言别名表</b>：把「中文 / Chinese / zh-CN / 简体中文」都认成同一门语言（M6）。
 *
 * <p>为什么要它：以前语言判定是<b>字符串全等</b> + 一堆 {@code contains("中文")} 的 if ——
 * 用户在配置里写「西语」「español」「Spanish」，代码只认其中一种写法，
 * 结果就是"我明明配了西语，它还是翻中文"。
 *
 * <p>现在统一走这里：
 * <pre>
 *   resolve("Español")   → 西班牙语
 *   resolve("zh-cn")     → 简体中文
 *   promptName("西语")    → Spanish      ← 发给模型的名字必须是英语
 *   same("Chinese", "简体中文") → true
 * </pre>
 *
 * <p><b>不依赖 Minecraft</b>：纯字符串逻辑，能被离线自测直接覆盖。
 */
public final class Language {

    /** 规范名（写进配置/日志时用这些）。 */
    public static final String ZH = "简体中文";
    public static final String EN = "英语";
    public static final String VI = "越南语";
    public static final String RU = "俄语";
    public static final String ES = "西班牙语";
    public static final String FR = "法语";
    public static final String JA = "日语";
    public static final String KO = "韩语";

    /** 规范名 → 发给模型用的英文名（模型对中文语言名会翻错，实测见 systemPrompt 注释）。 */
    private static final Map<String, String> PROMPT_NAMES = new LinkedHashMap<>();
    /** 规范名 → ISO 639-1 代码（mymemory 这类 GET 源要用）。 */
    private static final Map<String, String> ISO_CODES = new LinkedHashMap<>();
    /** 别名（小写、去空格） → 规范名。 */
    private static final Map<String, String> ALIASES = new LinkedHashMap<>();
    /** 用户自定义：别名 → 规范名（来自 1-translate.json 的 languages 数组）。 */
    private static final Map<String, String> CUSTOM = new LinkedHashMap<>();

    static {
        PROMPT_NAMES.put(ZH, ZH);       // 中文目标原样发（老行为，模型看得懂）
        PROMPT_NAMES.put(EN, "English");
        PROMPT_NAMES.put(VI, "Vietnamese");
        PROMPT_NAMES.put(RU, "Russian");
        PROMPT_NAMES.put(ES, "Spanish");
        PROMPT_NAMES.put(FR, "French");
        PROMPT_NAMES.put(JA, "Japanese");
        PROMPT_NAMES.put(KO, "Korean");

        ISO_CODES.put(ZH, "zh");
        ISO_CODES.put(EN, "en");
        ISO_CODES.put(VI, "vi");
        ISO_CODES.put(RU, "ru");
        ISO_CODES.put(ES, "es");
        ISO_CODES.put(FR, "fr");
        ISO_CODES.put(JA, "ja");
        ISO_CODES.put(KO, "ko");

        alias(ZH, "中文", "汉语", "普通话", "简体", "简体中文", "繁体中文", "chinese", "zh", "zh-cn", "zh_cn", "zh-hans", "zh-tw", "cn");
        alias(EN, "英文", "英语", "english", "en", "en-us", "en_us", "en-gb", "eng");
        alias(VI, "越南语", "越语", "vietnamese", "vi", "vi-vn", "tiếng việt", "tieng viet");
        alias(RU, "俄语", "俄文", "russian", "ru", "ru-ru", "русский", "рус");
        alias(ES, "西班牙语", "西语", "spanish", "es", "es-es", "español", "espanol", "castellano");
        alias(FR, "法语", "法文", "french", "fr", "fr-fr", "français", "francais");
        alias(JA, "日语", "日文", "日本語", "japanese", "ja", "ja-jp", "jp");
        alias(KO, "韩语", "韩国语", "한국어", "korean", "ko", "ko-kr", "kr");
    }

    private Language() {
    }

    private static void alias(String canonical, String... names) {
        for (String n : names) {
            ALIASES.put(key(n), canonical);
        }
    }

    private static String key(String s) {
        return s == null ? "" : s.trim().toLowerCase(Locale.ROOT).replace('_', '-');
    }

    /** 内置规范名（顺序固定，便于文档/测试断言）。 */
    public static List<String> canonicals() {
        return List.copyOf(PROMPT_NAMES.keySet());
    }

    /**
     * 装用户自定义别名：数组里每项支持两种写法：
     * <pre>
     *   "西语=西班牙语"      ← 别名=规范名
     *   "西班牙语"           ← 只列规范名（相当于确认支持）
     * </pre>
     * 规范名写错（不在内置 8 种里）就忽略该项并留日志。
     */
    public static synchronized void setCustom(List<String> entries) {
        CUSTOM.clear();
        if (entries == null) {
            return;
        }
        for (String raw : entries) {
            if (raw == null || raw.isBlank()) {
                continue;
            }
            int eq = raw.indexOf('=');
            if (eq < 0) {
                String c = resolveBuiltin(raw);
                if (c == null) {
                    obro1961.chatpatches.ChatPatches.LOGGER.warn(
                            "[chatpatch] languages 里的「{}」不是已知语言名，已忽略", raw.trim());
                }
                continue;
            }
            String alias = raw.substring(0, eq).trim();
            String canonical = raw.substring(eq + 1).trim();
            String c = resolveBuiltin(canonical);
            if (c == null) {
                obro1961.chatpatches.ChatPatches.LOGGER.warn(
                        "[chatpatch] languages 里的「{}」映射到未知语言「{}」，已忽略", alias, canonical);
                continue;
            }
            if (!alias.isEmpty()) {
                CUSTOM.put(key(alias), c);
            }
        }
    }

    /** 只认内置表的解析结果（给 setCustom 校验用）。 */
    public static String resolveBuiltin(String raw) {
        if (raw == null || raw.isBlank()) {
            return null;
        }
        String k = key(raw);
        for (String c : PROMPT_NAMES.keySet()) {
            if (key(c).equals(k)) {
                return c;
            }
        }
        return ALIASES.get(k);
    }

    /** 解析成规范名：先用户自定义，再内置；不认识返回 {@code null}。 */
    public static String resolve(String raw) {
        if (raw == null || raw.isBlank()) {
            return null;
        }
        String k = key(raw);
        String custom = CUSTOM.get(k);
        if (custom != null) {
            return custom;
        }
        return resolveBuiltin(raw);
    }

    /** 两个写法是不是同一门语言（任一解析失败就退回字符串忽略大小写比较）。 */
    public static boolean same(String a, String b) {
        String ra = resolve(a);
        String rb = resolve(b);
        if (ra != null && rb != null) {
            return ra.equals(rb);
        }
        return key(a).equals(key(b));
    }

    /** 目标语言是不是中文（术语表整句命中只看这一条）。 */
    public static boolean isChinese(String raw) {
        return ZH.equals(resolve(raw));
    }

    /** ISO 代码（GET 型源用）；不认识返回 {@code null}。 */
    public static String iso(String raw) {
        String c = resolve(raw);
        return c == null ? null : ISO_CODES.get(c);
    }

    /**
     * 发给模型的语言名：**必须是英语**（中文语言名会让模型把内容翻成中文，实测见 systemPrompt 注释）。
     * 不认识的语言原样返回 —— 至少不会把它误判成别的语言。
     */
    public static String promptName(String raw) {
        String c = resolve(raw);
        if (c == null) {
            return raw == null || raw.isBlank() ? "English" : raw;
        }
        // ★ 中文目标【原样返回】：老行为就是"用户写中文，就一个字都不动"（实测模型看得懂），
        //   这里改成规范名（中文→简体中文）虽然更"整齐"，但会让配置值在提示词里变样。
        if (ZH.equals(c)) {
            return raw;
        }
        return PROMPT_NAMES.getOrDefault(c, raw);
    }

    /** 跑单测/排错用：当前用户自定义了多少条。 */
    public static int customCount() {
        return CUSTOM.size();
    }

    /** 纯测试辅助：构造一份别名数组示例（不写进配置）。 */
    public static List<String> sampleCustom() {
        List<String> l = new ArrayList<>();
        l.add("歪果话=英语");
        return l;
    }
}
